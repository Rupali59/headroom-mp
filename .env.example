# Server-side only. NEVER prefix with NEXT_PUBLIC_ — that inlines the value
# into the client bundle, which is the exact leak the API routes exist to avoid.
ANTHROPIC_API_KEY=

# Cluster URI with NO database path. One URI serves every environment;
# MONGODB_DB below is what selects the environment.
MONGODB_URI=

# Headroom_MP_local | Headroom_MP_dev | Headroom_MP_preview | Headroom_MP_prod
MONGODB_DB=Headroom_MP_local

PORT=3205
